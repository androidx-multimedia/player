<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0E17">

    <!-- Top Action Bar Header -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="#1A1829"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Local Videos Gallery"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVideoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="#FFCC00"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="12 Videos" />
    </RelativeLayout>

    <!-- RecyclerView for Local Videos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVideos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar"
        android:clipToPadding="false"
        android:padding="16dp"
        tools:listitem="@layout/item_video" />

    <!-- Fallback / Empty Container when local storage has no videos -->
    <ScrollView
        android:id="@+id/emptyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/topBar"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_aspect_ratio"
                app:tint="#6200EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Local Videos Found"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Grant storage permission or tap sample streams below to play in player screen."
                android:textColor="#A0A0B0"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#6200EE"
                android:text="Grant Storage Permission"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp" />

            <!-- Sample Videos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sample Demo Streams:"
                android:textColor="#FFCC00"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSampleMp4"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1F1B2E"
                android:text="Big Buck Bunny (Online MP4)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#382F56"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnSampleHls"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1F1B2E"
                android:text="Tears of Steel (HLS Stream)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#382F56"
                app:strokeWidth="1dp" />

            <Button
                android:id="@+id/btnSampleS22"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1F1B2E"
                android:text="Samsung Galaxy S22 Ultra Review"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                app:strokeColor="#382F56"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
