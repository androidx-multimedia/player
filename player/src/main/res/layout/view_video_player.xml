<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ExoPlayer Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view" />

    <!-- Transparent Touch Gesture Listener View -->
    <View
        android:id="@+id/gestureOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- Buffering Spinner -->
    <ProgressBar
        android:id="@+id/pbBuffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF0000"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- HUD Overlay Popups for Brightness, Volume, Seek -->
    <FrameLayout
        android:id="@+id/hudOverlayContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <!-- Brightness HUD -->
        <LinearLayout
            android:id="@+id/hudBrightness"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_hud_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_brightness"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvBrightnessPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="85%" />

            <ProgressBar
                android:id="@+id/pbBrightness"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="#FF0000"
                tools:progress="85" />
        </LinearLayout>

        <!-- Volume HUD -->
        <LinearLayout
            android:id="@+id/hudVolume"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_hud_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_volume"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvVolumePercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="60%" />

            <ProgressBar
                android:id="@+id/pbVolume"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="#FF0000"
                tools:progress="60" />
        </LinearLayout>

        <!-- Seek HUD -->
        <LinearLayout
            android:id="@+id/hudSeek"
            android:layout_width="160dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_hud_rounded"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSeekDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF0000"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="+00:10" />

            <TextView
                android:id="@+id/tvSeekTargetPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                tools:text="02:45 / 10:00" />
        </LinearLayout>
    </FrameLayout>

    <!-- Main Player Controls Overlay (YouTube Style) -->
    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000">

        <!-- 1. Top Header Bar: Down Arrow + Title & Subtitle + Action Icons -->
        <RelativeLayout
            android:id="@+id/topBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_overlay_gradient_top"
            android:paddingHorizontal="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse"
                android:src="@drawable/ic_arrow_down"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/topActionsContainer"
                android:layout_toEndOf="@+id/btnBack"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Samsung Galaxy S22, S22+, and S22 Ult... ›" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    tools:text="GSMArena Official" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topActionsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnCast"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cast"
                    android:src="@drawable/ic_cast"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnTrackSelection"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Subtitles"
                    android:src="@drawable/ic_subtitles"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnSpeed"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnLock"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Lock Controls"
                    android:src="@drawable/ic_unlock"
                    app:tint="#FFFFFF" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 2. Center Controls: Rewind (Skip Prev), Center Play Triangle, Forward (Skip Next) -->
        <LinearLayout
            android:id="@+id/centerControlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:padding="8dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Play/Pause"
                android:padding="4dp"
                android:src="@drawable/ic_play"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:padding="8dp"
                android:src="@drawable/ic_skip_next"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- 3. Bottom Section: Timestamps, Red Seekbar, Action Buttons & More Videos Pill -->
        <LinearLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_overlay_gradient_bottom"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <!-- Timestamps & Chapter Title (Above Seekbar) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="1:43" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" / "
                        android:textColor="#D0D0D0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D0D0D0"
                        android:textSize="13sp"
                        tools:text="4:09" />

                    <TextView
                        android:id="@+id/tvChapterTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        tools:text="· Screen and display quality ›" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnFullscreen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fullscreen"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="#FFFFFF" />
            </RelativeLayout>

            <!-- YouTube Style Thin Red Seekbar -->
            <SeekBar
                android:id="@+id/sbVideoProgress"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:max="1000"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progressBackgroundTint="#50FFFFFF"
                android:progressTint="#FF0000"
                android:secondaryProgressTint="#80FFFFFF"
                android:thumbTint="#FF0000" />

            <!-- Bottom Outlined Action Row (Like, Dislike, Comment, Save, Share) + More Videos Card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnLike"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_outlined_circle"
                        android:contentDescription="Like"
                        android:padding="8dp"
                        android:src="@drawable/ic_like"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnDislike"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outlined_circle"
                        android:contentDescription="Dislike"
                        android:padding="8dp"
                        android:src="@drawable/ic_dislike"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnComment"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outlined_circle"
                        android:contentDescription="Comment"
                        android:padding="8dp"
                        android:src="@drawable/ic_comment"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnPlaylist"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outlined_circle"
                        android:contentDescription="Save"
                        android:padding="8dp"
                        android:src="@drawable/ic_playlist_add"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/btnShare"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_outlined_circle"
                        android:contentDescription="Share"
                        android:padding="8dp"
                        android:src="@drawable/ic_share"
                        app:tint="#FFFFFF" />
                </LinearLayout>

                <!-- "More Videos - Tap to see all" Pill Card -->
                <LinearLayout
                    android:id="@+id/btnMoreVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_container"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="More Videos"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to see all"
                            android:textColor="#AAAAAA"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_aspect_ratio"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Locked Touch Overlay -->
    <FrameLayout
        android:id="@+id/lockedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnUnlockCenter"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Unlock Controls"
            android:padding="14dp"
            android:src="@drawable/ic_lock"
            app:tint="#FF0000" />
    </FrameLayout>
</FrameLayout>
